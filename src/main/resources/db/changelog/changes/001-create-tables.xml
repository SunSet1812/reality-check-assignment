<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-player" author="assignment">

        <createTable tableName="player">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints
                        primaryKey="true"
                        nullable="false"/>
            </column>

            <column name="franchise_id" type="BIGINT"/>

            <column name="username" type="VARCHAR(64)"/>
            <column name="email" type="VARCHAR(128)"/>
            <column name="first_name" type="VARCHAR(64)"/>
            <column name="last_name" type="VARCHAR(64)"/>
            <column name="gender" type="VARCHAR(16)"/>

            <column name="birth_date" type="DATE"/>

            <column name="country" type="VARCHAR(2)"/>
            <column name="city" type="VARCHAR(64)"/>
            <column name="address" type="VARCHAR(128)"/>
            <column name="postal_code" type="VARCHAR(16)"/>
            <column name="phone" type="VARCHAR(32)"/>
            <column name="currency" type="VARCHAR(3)"/>
            <column name="language" type="VARCHAR(8)"/>
            <column name="timezone" type="VARCHAR(48)"/>

            <column name="registered_at" type="TIMESTAMP"/>
            <column name="last_login_at" type="TIMESTAMP"/>

            <column name="kyc_status" type="VARCHAR(16)"/>
            <column name="vip_level" type="INT"/>
            <column name="marketing_opt_in" type="BOOLEAN"/>
            <column name="self_excluded" type="BOOLEAN"/>

            <column name="deposit_limit_minor" type="BIGINT"/>
            <column name="balance_minor" type="BIGINT"/>
            <column name="bonus_balance_minor" type="BIGINT"/>
            <column name="loyalty_points" type="BIGINT"/>

            <column name="affiliate_id" type="VARCHAR(32)"/>
            <column name="referral_code" type="VARCHAR(32)"/>
            <column name="risk_score" type="INT"/>
            <column name="account_status" type="VARCHAR(16)"/>

            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>

        </createTable>

    </changeSet>


    <changeSet id="002-create-player-session" author="assignment">

        <createTable tableName="player_session">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints
                        primaryKey="true"
                        nullable="false"/>
            </column>

            <column name="player_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="franchise_id" type="BIGINT"/>

            <column name="status" type="VARCHAR(16)"/>

            <column name="interval_minutes" type="INT"/>

            <column name="started_at" type="TIMESTAMP"/>

            <column name="last_prompt_at" type="TIMESTAMP"/>

            <column name="elapsed_seconds" type="BIGINT"/>

            <column name="net_amount_minor" type="BIGINT"/>

            <column name="acknowledged" type="BOOLEAN"/>

            <column name="next_check_at" type="TIMESTAMP"/>

        </createTable>

    </changeSet>


    <changeSet id="003-add-player-session-player-fk" author="assignment">

        <addForeignKeyConstraint
                baseTableName="player_session"
                baseColumnNames="player_id"
                referencedTableName="player"
                referencedColumnNames="id"
                constraintName="fk_player_session_player"/>

    </changeSet>


    <changeSet id="004-create-player-session-acknowledgement" author="assignment">

        <createTable tableName="player_session_acknowledgement">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints
                        primaryKey="true"
                        nullable="false"/>
            </column>

            <column name="player_session_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="acknowledged_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

        </createTable>

    </changeSet>


    <changeSet id="005-add-acknowledgement-session-fk" author="assignment">

        <addForeignKeyConstraint
                baseTableName="player_session_acknowledgement"
                baseColumnNames="player_session_id"
                referencedTableName="player_session"
                referencedColumnNames="id"
                constraintName="fk_acknowledgement_player_session"/>

    </changeSet>

</databaseChangeLog>